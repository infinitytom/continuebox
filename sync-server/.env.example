PORT=8080
# Official base image; configure a trusted mirror if needed.
PYTHON_IMAGE=python:3.12-slim
TOKEN_SECRET=请替换为至少32位的随机字符串
TOKEN_DAYS=30
ALLOW_REGISTER=true
# 管理员填写已存在的账号名，逗号分隔，不要使用可被抢注的未创建账号名。
ADMIN_USERNAMES=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_FROM=
# 只在NAS本地填写QQ邮箱SMTP授权码，不是QQ登录密码。
SMTP_PASSWORD=
# 仅信任反向代理实际来源IP，禁止填写 *。
FORWARDED_ALLOW_IPS=127.0.0.1
MAX_RECORDS=30
TMDB_READ_TOKEN=
TMDB_LANGUAGE=zh-CN
TMDB_CACHE_DAYS=30
DANDAN_APP_ID=
DANDAN_APP_SECRET=
DANDAN_API_BASE=https://api.dandanplay.net
DANDAN_AUTH_MODE=credential
DANDAN_VIA_PROXY=false
DANDAN_CACHE_SECONDS=21600
# 替代方案：自建弹弹play兼容弹幕服务（如 misaka_danmu_server / danmu_api）。
# 填写自建服务地址后，可不配置上面的 AppId/AppSecret（自建服务无需官方签名）：
# DANDAN_API_BASE=http://192.168.x.x:7768/api/你的token
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
NEODB_API_BASE=https://neodb.social
NEODB_CLIENT_ID=
NEODB_CLIENT_SECRET=
NEODB_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
NEODB_VISIBILITY=2
# 可选：出站代理，仅用于 TMDB/Trakt/弹弹play/NeoDB 等外部接口（国内网络建议配置）
# 支持 http://192.168.1.2:7890 或 socks5h://192.168.1.2:7891
OUTBOUND_PROXY=
# 评论聚合结果缓存秒数
REVIEWS_CACHE_SECONDS=900
# 构建镜像时的 pip 源。国内默认清华镜像；海外部署或走代理时改为官方源：
# PIP_INDEX_URL=https://pypi.org/simple
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
